# =============================================================================
# B2B SaaS Platform — Active Environment Configuration
# =============================================================================
# LEGEND:
#   ✅ INJECTED   — Value set automatically; works out of the box
#   🔑 REQUIRED   — You must supply this from your external service dashboard
#   ⚙️  OPTIONAL   — Leave blank or commented out unless you need the feature
# =============================================================================


# =============================================================================
# DATABASES                                                         🔑 REQUIRED
# =============================================================================

# Your Neon (or any PostgreSQL) connection string.
# Get it from: https://console.neon.tech → Your Project → Connection Details
# Click "Pooled connection" and copy the URL with ?sslmode=require appended.
DATABASE_URL=DATABASE_URL='postgresql://neondb_owner:npg_peb8zHX5ORyB@ep-fragrant-cake-axw2ieex-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# A SECOND Neon database for the tenant control plane (tenant registry & plans).
# Create a second project/database on Neon and paste its pooled URL here.
# Or use the same Neon project with a different database name.
CONTROL_PLANE_DATABASE_URL=DATABASE_URL='postgresql://neondb_owner:npg_peb8zHX5ORyB@ep-fragrant-cake-axw2ieex-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require'


# =============================================================================
# REDIS                                                             🔑 REQUIRED
# =============================================================================

# Your Redis connection string.
# Free options:
#   • Upstash:      https://console.upstash.com → Create Database → REST URL
#                   Format: rediss://default:PASSWORD@ENDPOINT:PORT
#   • Redis Cloud:  https://app.redislabs.com → Create Subscription → Endpoint
#                   Format: redis://default:PASSWORD@ENDPOINT:PORT
REDIS_URL="rediss://default:gQAAAAAAATJdAAIgcDFhZmE5OTljNjMzOWU0ZjI4Yjg2NmVkYmRkNGVjNTE2OQ@advanced-ferret-78429.upstash.io:6379"


# =============================================================================
# MESSAGE BROKER (RabbitMQ)                                         ✅ INJECTED
# =============================================================================
# These defaults work when running `docker-compose up` locally.
# For a managed broker (CloudAMQP free tier → https://www.cloudamqp.com),
# replace both values with your CloudAMQP URL.

AMQP_ADDR=amqp://guest:guest@127.0.0.1:5672/%2f
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2f
RABBITMQ_USER=guest
RABBITMQ_PASS=guest


# =============================================================================
# AUTHENTICATION                                                     ✅ INJECTED
# =============================================================================
# Cryptographically generated 96-hex-char secret. DO NOT share or commit.
# All services must use the same SECRET value.

SECRET=ABC8606AC53C57574996EB6AAECF25ADAC5E867B621EF46C1E9A07F41A250445BF9E5844DB324B3E48802FF3D5478F2E


# =============================================================================
# SERVICE PORTS                                                      ✅ INJECTED
# =============================================================================

TENANT_MANAGEMENT_PORT=3000
# SERVICE_PORT is read by each service individually.
# When running all services locally (not Docker), start each in its own
# terminal with SERVICE_PORT set per process. Docker Compose handles this.


# =============================================================================
# REDIS STREAM CONSUMER NAMES                                        ✅ INJECTED
# =============================================================================
# Each service reads CONSUMER_NAME. When running via Docker Compose,
# each container gets its own value via the environment: block.
# For local single-process dev, set this to whatever service you're running.

CONSUMER_NAME=service-1


# =============================================================================
# STRIPE                                                            🔑 REQUIRED
# =============================================================================
# 1. Go to https://dashboard.stripe.com/test/apikeys
# 2. Copy your "Secret key" (starts with sk_test_ for test mode)
# 3. For the webhook secret:
#    → Stripe Dashboard → Developers → Webhooks → Add endpoint
#    → Set endpoint URL to: https://your-domain.com/payments/webhook
#    → Select events: payment_intent.succeeded, payment_intent.payment_failed
#    → After creating, click "Reveal" under "Signing secret" (starts with whsec_)

STRIPE_SECRET_KEY=sk_test_REDACTED_ROTATE_YOUR_STRIPE_KEY
STRIPE_WEBHOOK_SECRET=whsec_wpjyrHGqK7EiHBUgnN0diwGIfFlk99Rs


# =============================================================================
# CLOUDINARY (Product Image Uploads)                                🔑 REQUIRED
# =============================================================================
# 1. Sign up free at https://cloudinary.com
# 2. Go to Dashboard → copy Cloud Name, API Key, API Secret

CLOUDINARY_CLOUD_NAME=drgwnkllv
CLOUDINARY_API_KEY=268256438494188
CLOUDINARY_API_SECRET=HCg4pr8sY2VhSeMku72byaJUlrc


# =============================================================================
# NOTIFICATIONS                                                      ✅ INJECTED
# =============================================================================
# NOTIFICATION_DRY_RUN=true means all notifications are LOGGED, not sent.
# Set to "false" only when your Twilio/SendGrid keys are configured below.

NOTIFICATION_DRY_RUN=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# --- SendGrid (Email)                                              ⚙️  OPTIONAL
# 1. Sign up at https://sendgrid.com (free tier: 100 emails/day)
# 2. Settings → API Keys → Create API Key (Full Access)
# 3. Verify a sender email at Settings → Sender Authentication

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Twilio (SMS)                                                  ⚙️  OPTIONAL
# 1. Sign up at https://www.twilio.com/try-twilio (free trial credit included)
# 2. Console Dashboard → Account SID and Auth Token (visible on home page)
# 3. Phone Numbers → Manage → Buy a number (free with trial credit)

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Expo Push (Mobile Push Notifications)                         ⚙️  OPTIONAL
# 1. Sign up at https://expo.dev
# 2. Account Settings → Access Tokens → Create token

EXPO_ACCESS_TOKEN=

# --- Webhook Fallbacks                                             ✅ INJECTED
EMAIL_WEBHOOK_URL=http://localhost:8080/email/webhook
SMS_WEBHOOK_URL=http://localhost:8080/sms/webhook


# =============================================================================
# SERVICE DISCOVERY                                                  ✅ INJECTED
# =============================================================================

SUPPLIER_MANAGEMENT_URL=http://localhost:3004
GATEWAY_URL=http://127.0.0.1:80


# =============================================================================
# OBSERVABILITY                                                      ✅ INJECTED
# =============================================================================

RUST_LOG=info

# OpenTelemetry (Jaeger / Grafana Tempo etc.)                       ⚙️  OPTIONAL
# Uncomment and set if you are running an OTLP collector locally.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317


# =============================================================================
# DOCKER INFRASTRUCTURE                                              ✅ INJECTED
# =============================================================================
# Used only by docker-compose, not read directly by Rust services.

DB_PASSWORD=commerce_secret
CONTROL_DB_PASSWORD=control_secret
ANALYTICS_DB_PASSWORD=analytics_secret
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false