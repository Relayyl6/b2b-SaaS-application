# =============================================================================
# B2B SaaS Platform — Complete Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in your real values.
# All services read from this single file via dotenvy::dotenv().
# =============================================================================


# =============================================================================
# SECTION 1: DATABASES
# =============================================================================

# --- Shared Application Database (Neon / PostgreSQL) ---
# Used by: user-management, product-catalog, order-service,
#          inventory-management, supplier-management, payments,
#          analytics, logistics, notifications, e2e-tests
DATABASE_URL=postgres://user:password@your-neon-endpoint.neon.tech/dbname?sslmode=require

# --- Tenant Control Plane Database ---
# Used by: tenant-management service ONLY
# This is a SEPARATE database from the main DATABASE_URL above.
# It stores tenant registry, plans, and multi-tenant metadata.
CONTROL_PLANE_DATABASE_URL=postgres://control_user:control_secret@your-neon-endpoint.neon.tech/commerce_control?sslmode=require

# --- Docker Infrastructure Database Credentials (docker-compose only) ---
# These are used when running the stack locally via docker-compose.
# They are NOT read directly by the Rust services.
DB_PASSWORD=commerce_secret
CONTROL_DB_PASSWORD=control_secret
ANALYTICS_DB_PASSWORD=analytics_secret


# =============================================================================
# SECTION 2: REDIS
# =============================================================================

# Used by: ALL microservices (tenant auth middleware, rate limiting,
#          event stream pub/sub, usage counters, token revocation)
# Used by: e2e-tests (TestHarness for seeding test data)
#
# For managed Redis (e.g. Upstash), the URL format is:
#   redis://default:YOUR_PASSWORD@YOUR_ENDPOINT:PORT
# For TLS (rediss://):
#   rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT:PORT
REDIS_URL=redis://127.0.0.1:6379


# =============================================================================
# SECTION 3: MESSAGE BROKER (RabbitMQ / AMQP)
# =============================================================================

# Used by: analytics, product-catalog, notifications, logistics
# AMQP_ADDR and RABBITMQ_URL are equivalent — both are referenced
# by different services. Set them to the same broker URL.
AMQP_ADDR=amqp://guest:guest@127.0.0.1:5672/%2f
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2f

# Docker-compose broker credentials
RABBITMQ_USER=guest
RABBITMQ_PASS=guest


# =============================================================================
# SECTION 4: AUTHENTICATION & SECURITY
# =============================================================================

# JWT signing secret — used by user-management, platform middleware,
# analytics, and all e2e-tests. Must be the same value across all services.
SECRET=change-me-to-a-strong-random-secret


# =============================================================================
# SECTION 5: SERVICE PORTS
# =============================================================================

# Each service reads SERVICE_PORT (primary) with PORT as fallback.
# Uncomment and set these if you need to override the defaults.

TENANT_MANAGEMENT_PORT=3000
# SERVICE_PORT=3001          # user-management  (default: 3001)
# SERVICE_PORT=3003          # product-catalog   (default: 3003)
# SERVICE_PORT=3004          # supplier-management (default: 3004)
# SERVICE_PORT=3005          # order-service     (default: 3005)
# SERVICE_PORT=3006          # inventory-service (default: 3006)
# SERVICE_PORT=3007          # analytics         (default: 3007)
# SERVICE_PORT=3008          # logistics         (default: 3008)
# SERVICE_PORT=3009          # payments          (default: 3009)
# SERVICE_PORT=3010          # notifications     (default: 3010)


# =============================================================================
# SECTION 6: REDIS STREAM CONSUMER NAMES
# =============================================================================
# Each service needs a unique consumer group member name so that Redis
# stream events are correctly distributed and acknowledged.
# These are read as CONSUMER_NAME by each respective service.
# When running multiple instances, use distinct names per instance.

ORDER_CONSUMER_NAME=order-service-1
INVENTORY_CONSUMER_NAME=inventory-1
PAYMENTS_CONSUMER_NAME=payments-1
ANALYTICS_CONSUMER_NAME=analytics-worker-1
LOGISTICS_CONSUMER_NAME=logistics-1
NOTIFICATIONS_CONSUMER_NAME=notifications-1

# Note: Each service reads the env var as CONSUMER_NAME.
# When deploying with docker-compose, override per container.
CONSUMER_NAME=service-1


# =============================================================================
# SECTION 7: STRIPE (Payments)
# =============================================================================

# Used by: payments service
# Stripe secret key. Leave empty to run in mock/test mode.
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET_HERE


# =============================================================================
# SECTION 8: CLOUDINARY (Product Catalog — Image Storage)
# =============================================================================

# Used by: product-catalog service for signing upload requests
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# =============================================================================
# SECTION 9: NOTIFICATIONS
# =============================================================================

# --- General ---
# Set to "false" to actually send notifications.
# When "true", notifications are logged only (safe for development).
NOTIFICATION_DRY_RUN=true

# --- SendGrid (Email) ---
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# --- Expo (Push Notifications) ---
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# --- Webhook Fallbacks ---
EMAIL_WEBHOOK_URL=http://localhost:8080/email/webhook
SMS_WEBHOOK_URL=http://localhost:8080/sms/webhook


# =============================================================================
# SECTION 10: SERVICE DISCOVERY (Internal URLs)
# =============================================================================

# Used by: payments service to call supplier-management over HTTP
SUPPLIER_MANAGEMENT_URL=http://localhost:3004

# Used by: e2e-tests to call the API gateway
GATEWAY_URL=http://127.0.0.1:80


# =============================================================================
# SECTION 11: OBSERVABILITY
# =============================================================================

# Tracing log level. Options: trace, debug, info, warn, error
RUST_LOG=info

# OpenTelemetry OTLP collector endpoint (optional).
# Uncomment to enable distributed tracing export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317


# =============================================================================
# SECTION 12: DOCKER INFRASTRUCTURE (docker-compose only)
# =============================================================================

# PgAdmin web UI credentials
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin

# Grafana admin credentials
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
