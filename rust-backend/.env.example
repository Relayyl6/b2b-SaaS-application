DATABASE_URL=postgres://user:password@localhost:5432/my_database
# Note: For Neon Serverless Postgres, use the pooled connection string format:
# DATABASE_URL=postgres://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require

REDIS_URL=redis://127.0.0.1:6379/
AMQP_ADDR=amqp://guest:guest@127.0.0.1:5672/%2f
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2f

# JWT Secret for User Authentication
SECRET=my_super_secret_jwt_key

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary (Product Catalog Images)
CLOUDINARY_CLOUD_NAME=my_cloud_name
CLOUDINARY_API_KEY=my_api_key
CLOUDINARY_API_SECRET=my_api_secret

# Notifications
NOTIFICATION_DRY_RUN=true
EMAIL_WEBHOOK_URL=http://localhost:8080/email/webhook
SMS_WEBHOOK_URL=http://localhost:8080/sms/webhook
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# Optional: OpenTelemetry Metrics endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Microservice internal URLs (for service-to-service calls if not using events)
SUPPLIER_MANAGEMENT_URL=http://localhost:3004

# Individual Service Ports (Usually handled by Docker Compose)
# USER_MANAGEMENT_PORT=3001
# PRODUCT_CATALOG_PORT=3003
# SUPPLIER_MANAGEMENT_PORT=3004
# ORDER_SERVICE_PORT=3005
# INVENTORY_MANAGEMENT_PORT=3006
# ANALYTICS_PORT=3007
# LOGISTICS_PORT=3008
# PAYMENTS_PORT=3009
# NOTIFICATIONS_PORT=3010
